# Forge API (server-only — never prefix with VITE_)
BRAIINS_API_TOKEN=
FORGE_OPERATOR_PASSWORD=
FORGE_SESSION_SECRET=
FORGE_SESSION_TTL_SECONDS=
# Primary production path (Netlify /api proxy) uses lax. Set none only for
# direct cross-origin browser → Render testing.
FORGE_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
PORT=8787
RATE_LIMIT_PER_MINUTE=60
BRAIINS_TIMEOUT_MS=12000
BRAIINS_REQUEST_INTERVAL_MS=5000

# Durable owner ledger (SQLite). Default: ./data/forge.db
# On Render, mount a persistent disk and set this to e.g. /var/data/forge.db
FORGE_DATABASE_PATH=
# Optional bearer secret for POST /api/jobs/snapshots (cron / platform scheduler)
FORGE_JOB_TRIGGER_SECRET=

# Frontend — optional. Leave unset for same-origin /api (Vite/Netlify proxy).
# Set only for local/preview/alternate topology that calls Forge directly.
VITE_FORGE_API_BASE_URL=
